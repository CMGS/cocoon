# Example Cocoonfile for Cocoon VM image build
#
# Usage:
#   cocoon image build --file cocoonfile.example --tag my-vm:latest
#
# FROM resolution (local-first):
#   1) local file path (or existing file relative to this Cocoonfile)
#   2) local OCI tag (implicit :latest supported)
#   3) http(s) cloud-image URL
#   4) OCI reference (Docker-like normalization)

FROM https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img

RUN echo 'virtiofs' >> /etc/initramfs-tools/modules && update-initramfs -u -k all

# Demo-only password setup for local testing. Use SSH keys in production.
RUN echo 'root:eruCocoon' | chpasswd

LABEL maintainer="cocoon"
LABEL base="ubuntu-noble"
